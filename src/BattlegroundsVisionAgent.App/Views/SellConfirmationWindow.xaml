<Window x:Class="BattlegroundsVisionAgent.App.Views.SellConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认临时卖出" Width="390" Height="190" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" PreviewKeyDown="OnPreviewKeyDown"
        Deactivated="OnDeactivated" Closing="OnClosing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="场面已满，需要临时卖出随从。" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0" Text="关闭窗口、按 Esc、失去焦点或超时都会保持不动。" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Padding="12,6" Content="保持不动" Click="OnKeepStill" IsCancel="True" />
            <Button Padding="12,6" Content="确认卖出" Click="OnConfirmSell" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
